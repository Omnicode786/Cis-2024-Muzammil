generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AuthProvider {
  PASSWORD @map("password")
  OTP      @map("otp")
  GOOGLE   @map("google")
}

enum UserType {
  ADMIN
  STAFF
}

enum StaffDesignation {
  MANAGER
  CASHIER
  OTHER
}

enum SupplierPaymentType {
  CASH
  CREDIT
}

enum BillingCategory {
  GROCERIES
  ELECTRICITY
  OTHER
}

enum PaymentMethod {
  CASH
  BANK
  WALLET
  CARD
}

enum SupplierTransactionType {
  PURCHASE
  PAYMENT
  ADJUSTMENT
  BONUS
  RETURN
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Shop {
  shopId                  BigInt                  @id @default(autoincrement()) @map("shop_id")
  shopName                String                  @map("shop_name") @db.VarChar(255)
  legalName               String?                 @map("legal_name") @db.VarChar(255)
  shopCode                String                  @unique @map("shop_code") @db.VarChar(100)
  phoneNumber             String?                 @map("phone_number") @db.VarChar(30)
  email                   String?                 @unique @db.VarChar(255)
  address                 String?                 @db.Text
  currencyCode            String                  @default("PKR") @map("currency_code") @db.Char(3)
  timezone                String                  @default("Asia/Karachi") @db.VarChar(100)
  isActive                Boolean                 @default(true) @map("is_active")
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                   ShopUser[]
  customers               Customer[]
  suppliers               Supplier[]
  customerBillingLogs     CustomerBillingLog[]
  paymentLogs             PaymentLog[]
  supplierTransactionLogs SupplierTransactionLog[]
  refreshSessions         RefreshSession[]
  aiThreads               AiThread[]
  aiMessages              AiMessage[]

  @@map("shop")
}

model ShopUser {
  shopUserId                  BigInt                     @id @default(autoincrement()) @map("shop_user_id")
  shopId                      BigInt                     @map("shop_id")
  fullName                    String                     @map("full_name") @db.VarChar(255)
  email                       String                     @unique @db.VarChar(255)
  phoneNumber                 String?                    @unique @map("phone_number") @db.VarChar(30)
  passwordHash                String?                    @map("password_hash") @db.VarChar(255)
  authProvider                AuthProvider               @default(PASSWORD) @map("auth_provider")
  userType                    UserType                   @map("user_type")
  staffDesignation            StaffDesignation?          @map("staff_designation")
  isPrimaryContact            Boolean                    @default(false) @map("is_primary_contact")
  isActive                    Boolean                    @default(true) @map("is_active")
  lastLoginAt                 DateTime?                  @map("last_login_at") @db.Timestamptz(6)
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop                        Shop                       @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  customersCreated            Customer[]                 @relation("CustomerCreatedBy")
  suppliersCreated            Supplier[]                 @relation("SupplierCreatedBy")
  billingLogsCreated          CustomerBillingLog[]       @relation("BillingCreatedBy")
  paymentLogsCreated          PaymentLog[]               @relation("PaymentCreatedBy")
  supplierTransactionsCreated SupplierTransactionLog[]   @relation("SupplierTxnCreatedBy")
  refreshSessions             RefreshSession[]
  aiThreads                   AiThread[]
  aiMessages                  AiMessage[]

  @@unique([shopUserId, shopId], map: "uq_shop_user_id_shop")
  @@index([shopId], map: "idx_shop_user_shop")
  @@index([shopId, userType], map: "idx_shop_user_shop_type")
  @@index([shopId, isActive], map: "idx_shop_user_shop_active")
  @@map("shop_user")
}

model Customer {
  customerId          BigInt               @id @default(autoincrement()) @map("customer_id")
  shopId              BigInt               @map("shop_id")
  customerName        String               @map("customer_name") @db.VarChar(255)
  phoneNumber         String?              @map("phone_number") @db.VarChar(30)
  address             String?              @db.Text
  area                String?              @db.VarChar(100)
  isActive            Boolean              @default(true) @map("is_active")
  notes               String?              @db.Text
  createdByShopUserId BigInt               @map("created_by_shop_user_id")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop                Shop                 @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  createdBy           ShopUser             @relation("CustomerCreatedBy", fields: [createdByShopUserId, shopId], references: [shopUserId, shopId], onDelete: Restrict)
  billingLogs         CustomerBillingLog[] @relation("CustomerBillingLogs")
  paymentLogs         PaymentLog[]         @relation("CustomerPayments")

  @@unique([customerId, shopId], map: "uq_customer_id_shop")
  @@index([shopId, customerName], map: "idx_customer_shop_name")
  @@index([shopId, phoneNumber], map: "idx_customer_shop_phone")
  @@index([shopId, area], map: "idx_customer_shop_area")
  @@map("customer")
}

model Supplier {
  supplierId          BigInt                   @id @default(autoincrement()) @map("supplier_id")
  shopId              BigInt                   @map("shop_id")
  supplierName        String                   @map("supplier_name") @db.VarChar(255)
  phoneNumber         String?                  @map("phone_number") @db.VarChar(30)
  paymentType         SupplierPaymentType      @default(CASH) @map("payment_type")
  creditDays          Int?                     @map("credit_days")
  notes               String?                  @db.Text
  isActive            Boolean                  @default(true) @map("is_active")
  createdByShopUserId BigInt                   @map("created_by_shop_user_id")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop                Shop                     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  createdBy           ShopUser                 @relation("SupplierCreatedBy", fields: [createdByShopUserId, shopId], references: [shopUserId, shopId], onDelete: Restrict)
  transactions        SupplierTransactionLog[] @relation("SupplierTransactions")

  @@unique([supplierId, shopId], map: "uq_supplier_id_shop")
  @@index([shopId, supplierName], map: "idx_supplier_shop_name")
  @@index([shopId, phoneNumber], map: "idx_supplier_shop_phone")
  @@map("supplier")
}

model CustomerBillingLog {
  billingLogId        BigInt           @id @default(autoincrement()) @map("billing_log_id")
  shopId              BigInt           @map("shop_id")
  customerId          BigInt           @map("customer_id")
  billingDate         DateTime         @map("billing_date") @db.Date
  billingCategory     BillingCategory  @map("billing_category")
  description         String?          @db.Text
  amount              Decimal          @db.Decimal(12, 2)
  billingMonth        String           @map("billing_month") @db.Char(7)
  createdByShopUserId BigInt           @map("created_by_shop_user_id")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  shop                Shop             @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  customer            Customer         @relation("CustomerBillingLogs", fields: [customerId, shopId], references: [customerId, shopId], onDelete: Cascade)
  createdBy           ShopUser         @relation("BillingCreatedBy", fields: [createdByShopUserId, shopId], references: [shopUserId, shopId], onDelete: Restrict)

  @@index([shopId, customerId, billingDate], map: "idx_billing_shop_customer_date")
  @@index([shopId, billingMonth], map: "idx_billing_shop_month")
  @@index([shopId, billingCategory], map: "idx_billing_shop_category")
  @@map("customer_billing_log")
}

model PaymentLog {
  paymentId           BigInt         @id @default(autoincrement()) @map("payment_id")
  shopId              BigInt         @map("shop_id")
  customerId          BigInt         @map("customer_id")
  paymentDate         DateTime       @map("payment_date") @db.Date
  amountPaid          Decimal        @map("amount_paid") @db.Decimal(12, 2)
  paymentMethod       PaymentMethod  @map("payment_method")
  referenceNo         String?        @map("reference_no") @db.VarChar(100)
  remarks             String?        @db.Text
  createdByShopUserId BigInt         @map("created_by_shop_user_id")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  shop                Shop           @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  customer            Customer       @relation("CustomerPayments", fields: [customerId, shopId], references: [customerId, shopId], onDelete: Cascade)
  createdBy           ShopUser       @relation("PaymentCreatedBy", fields: [createdByShopUserId, shopId], references: [shopUserId, shopId], onDelete: Restrict)

  @@index([shopId, customerId, paymentDate], map: "idx_payment_shop_customer_date")
  @@index([shopId, paymentMethod], map: "idx_payment_shop_method")
  @@map("payment_log")
}

model SupplierTransactionLog {
  supplierTxnId       BigInt                   @id @default(autoincrement()) @map("supplier_txn_id")
  shopId              BigInt                   @map("shop_id")
  supplierId          BigInt                   @map("supplier_id")
  transactionDate     DateTime                 @map("transaction_date") @db.Date
  transactionType     SupplierTransactionType  @map("transaction_type")
  amount              Decimal                  @db.Decimal(12, 2)
  description         String?                  @db.Text
  createdByShopUserId BigInt                   @map("created_by_shop_user_id")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  shop                Shop                     @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  supplier            Supplier                 @relation("SupplierTransactions", fields: [supplierId, shopId], references: [supplierId, shopId], onDelete: Cascade)
  createdBy           ShopUser                 @relation("SupplierTxnCreatedBy", fields: [createdByShopUserId, shopId], references: [shopUserId, shopId], onDelete: Restrict)

  @@index([shopId, supplierId, transactionDate], map: "idx_supplier_txn_shop_supplier_date")
  @@index([shopId, transactionType], map: "idx_supplier_txn_shop_type")
  @@map("supplier_transaction_log")
}

model RefreshSession {
  refreshSessionId BigInt    @id @default(autoincrement()) @map("refresh_session_id")
  shopId           BigInt    @map("shop_id")
  shopUserId       BigInt    @map("shop_user_id")
  tokenHash        String    @unique @map("token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.Text
  ipAddress        String?   @map("ip_address") @db.VarChar(100)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  shop             Shop      @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  shopUser         ShopUser  @relation(fields: [shopUserId, shopId], references: [shopUserId, shopId], onDelete: Cascade)

  @@index([shopUserId, shopId], map: "idx_refresh_session_user_shop")
  @@index([expiresAt], map: "idx_refresh_session_expiry")
  @@index([revokedAt], map: "idx_refresh_session_revoked")
  @@map("refresh_session")
}

model AiThread {
  aiThreadId           BigInt      @id @default(autoincrement()) @map("ai_thread_id")
  shopId               BigInt      @map("shop_id")
  createdByShopUserId  BigInt      @map("created_by_shop_user_id")
  title                String      @db.VarChar(255)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop                 Shop        @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  createdBy            ShopUser    @relation(fields: [createdByShopUserId, shopId], references: [shopUserId, shopId], onDelete: Cascade)
  messages             AiMessage[]

  @@unique([aiThreadId, shopId], map: "uq_ai_thread_id_shop")
  @@index([shopId, updatedAt], map: "idx_ai_thread_shop_updated")
  @@index([createdByShopUserId, shopId], map: "idx_ai_thread_creator_shop")
  @@map("ai_thread")
}

model AiMessage {
  aiMessageId           BigInt        @id @default(autoincrement()) @map("ai_message_id")
  shopId                BigInt        @map("shop_id")
  aiThreadId            BigInt        @map("ai_thread_id")
  role                  AiMessageRole @map("role")
  content               String        @db.Text
  createdByShopUserId   BigInt?       @map("created_by_shop_user_id")
  modelName             String?       @map("model_name") @db.VarChar(100)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  shop                  Shop          @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  thread                AiThread      @relation(fields: [aiThreadId, shopId], references: [aiThreadId, shopId], onDelete: Cascade)
  createdBy             ShopUser?     @relation(fields: [createdByShopUserId, shopId], references: [shopUserId, shopId], onDelete: SetNull)

  @@index([shopId, aiThreadId, createdAt], map: "idx_ai_message_thread_created")
  @@index([createdByShopUserId, shopId], map: "idx_ai_message_creator_shop")
  @@map("ai_message")
}
